meta {
  name: Ajouter un jeu
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/games
  body: json
  auth: none
}

body:json {
  {
    "title": "Bruno collection test",
    "editor": "Test Studio",
    "releaseYear": 2022,
    "genre": "Action-RPG",
    "rating": 9.5
  }
}

assert {
  res.status: 201
}

script:post-response {
  bru.setVar("gameId", res.body.id);
}
